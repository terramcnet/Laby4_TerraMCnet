.container {
  top: 5;
  bottom: 20;
  left: 5;
  right: 5;
  renderer: "Card";
  background-color: var(--background-color);
  border-color: var(--background-color-border);
  border-radius: var(--border-radius);
  border-thickness: var(--border-thickness);

  .header {
    top: 1;
    left: 1;
    right: 1;
    height: 25;
    border-radius: 3 3 0 0;
    background-color: rgba(85, 255, 85, 0.2);

    .header-text {
      alignment-x: center;
      alignment-y: center;
    }

  }

}

.chat-status {
  bottom: 10;
  left: 10;
  font-size: 0.7;
}

.chat-reconnect-button {
  bottom: 17;
  left: 10;
  height: 10;
  padding: 0 2 0 2;
}

.not-connected-info {
  alignment-x: center;
  top: 40vh;
  text-color: dark_red;
}

.connect-text {
  alignment-x: center;
  top: 45vh;
  text-color: red;
}

.connect-button {
  alignment-x: center;
  top: 50vh;
  width: fit-content;
  padding: 0 5 0 5;
}

.overview-grid {
  top: 50;
  left: 0;
  height: fit-content;
  width: 100%;
  tiles-per-line: 4;
  tile-height: 75;
}

Overview {
  .entryIcon {
    alignment-x: center;
    top: 0;
    height: 20;
    width: 20;
  }
  .entryTitle {
    alignment-x: center;
    top: 30%;
  }
}